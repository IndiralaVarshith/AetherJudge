# App Configuration
NODE_ENV=development
PORT=5000
LOG_LEVEL=debug

# PostgreSQL
DB_USER=admin
DB_HOST=localhost
DB_NAME=aetherjudge
DB_PASSWORD=admin123
DB_PORT=5433

# Redis
REDIS_URL=redis://127.0.0.1:6380
REDIS_PASSWORD=

# Judge0
JUDGE0_URL=http://localhost:2358

# Secrets
JWT_SECRET=replace_with_local_development_jwt_secret
ADMIN_SECRET=replace_with_local_admin_secret

# Google sign-in (optional). Leave empty to hide the "Continue with Google" button.
# See README → "Setting up Continue with Google".
GOOGLE_CLIENT_ID=
CLIENT_ORIGIN=http://localhost:5173

# Session cookie (optional). Defaults: lax + not secure locally, none + secure in production.
# COOKIE_SAMESITE=none
# COOKIE_SECURE=true
