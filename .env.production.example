# ==============================================================================
# AetherJudge Production Environment Configuration Template
# Instructions:
# 1. Copy this file to .env.production on your production server:
#    cp .env.production.example .env.production
# 2. Generate strong secrets as instructed below.
# 3. NEVER commit .env.production or server secrets to Git.
# ==============================================================================

# Application Configuration
NODE_ENV=production
PORT=5000
LOG_LEVEL=info

# Primary PostgreSQL Database (Internal Docker Network)
# Generate a strong password: openssl rand -base64 24
DB_HOST=postgres
DB_PORT=5432
DB_USER=aether_admin
DB_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD
DB_NAME=aetherjudge

# Redis Queue & Cache (Internal Docker Network)
REDIS_URL=redis://redis:6379

# Judge0 Execution Engine (Internal Docker Network)
JUDGE0_URL=http://judge0-server:2358

# Security Secrets (MANDATORY IN PRODUCTION)
# Generate a secure 64-char hex secret: openssl rand -hex 32
JWT_SECRET=REPLACE_WITH_HEX_32_CHAR_JWT_SECRET

# Administrative secret for protected routes (e.g., adding problems)
# Generate via: openssl rand -hex 16
ADMIN_SECRET=REPLACE_WITH_STRONG_ADMIN_SECRET

# Frontend Allowed Origin for CORS
# Specify your real deployed frontend URL on Vercel:
# e.g., CLIENT_ORIGIN=https://aetherjudge.vercel.app
# Multiple origins may be comma-separated: https://app.domain.com,https://preview.domain.com
CLIENT_ORIGIN=https://your-frontend-domain.vercel.app

# Public Backend Domain / Hostname (Used for TLS / Certbot / reverse proxy)
BACKEND_DOMAIN=api.yourdomain.com
