# ==============================================================================
# AetherJudge production settings (used by docker-compose.prod.yml on the server)
#
# deploy.sh creates .env.production from this file on the first run, filling in
# random secrets and API_DOMAIN for you. Edit it afterwards if needed, then run
#   docker compose -f docker-compose.prod.yml up -d
# NEVER commit .env.production.
# ==============================================================================

NODE_ENV=production
PORT=5000

# Public name of this server. Caddy gets a free HTTPS certificate for it.
# Default: <public-ip-with-dashes>.sslip.io, a free name that points at your IP
# (e.g. 129-213-45-67.sslip.io). You can use your own domain instead.
API_DOMAIN=

# Your Vercel site, e.g. https://aetherjudge.vercel.app (no trailing slash).
CLIENT_ORIGIN=

# PostgreSQL (inside Docker)
DB_HOST=postgres
DB_PORT=5432
DB_USER=aether_admin
DB_PASSWORD=
DB_NAME=aetherjudge

# Redis and Judge0 (inside Docker)
REDIS_URL=redis://redis:6379
JUDGE0_URL=http://judge0-server:2358

# Secrets (deploy.sh generates these if empty)
JWT_SECRET=
ADMIN_SECRET=

# Optional: "Continue with Google". Same client ID as local; add your Vercel URL to
# its Authorized JavaScript origins in Google Cloud Console.
GOOGLE_CLIENT_ID=
